UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chaos mode controls
ENABLE_CHAOS=true
ZON_ADMIN_KEY=hackmitten-demo-admin-key-2026

# Target Victim Website URL (Separate Vercel deployment)
