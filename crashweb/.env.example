# Monitoring Server Connection (Hackmitten Dashboard)
MONITORING_SERVER_URL=http://localhost:8000
MONITORING_PROJECT_ID=proj_crashweb_01
MONITORING_API_KEY=key_live_crashweb_2026
NEXT_PUBLIC_MONITORING_SERVER_URL=http://localhost:8000
NEXT_PUBLIC_PROJECT_ID=proj_crashweb_01
